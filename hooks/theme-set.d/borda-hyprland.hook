#!/usr/bin/env bash
# Ao trocar o tema do Omarchy, leva junto as superficies que nao seguem sozinhas:
# borda da janela, cores do kitty e wallpaper. Tudo nivel de usuario e instantaneo.
#
# O splash de boot e o SDDM NAO estao aqui: pedem root e um minuto de mkinitcpio,
# e hook que pede senha ou trava no meio de uma troca de tema e pior que a
# inconsistencia. Para esses, na mao: omarchy-guest-theme-boot
exec "$HOME/.local/share/omarchy-guest/bin/omarchy-guest-theme-apply"

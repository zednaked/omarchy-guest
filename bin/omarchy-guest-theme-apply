#!/usr/bin/env bash
# Apply the current Omarchy theme to the surfaces it does not reach by itself.
#
# Three of them, all user-level and instant - no root, no initramfs. The boot
# splash and the login screen are the other two and live in
# omarchy-guest-theme-boot, because those need both.
#
#   window border   the host's theme owns col.active_border, so switching the
#                   Omarchy theme repainted the bar and left the border behind
#   kitty           the theme ships a kitty.conf, but `omarchy theme set` refuses
#                   to install it (kitty.conf is in its INSTALLED_THEME_DENIED
#                   list, correctly - it would clobber the user's own config).
#                   So the colours ship and nothing consumes them.
#   wallpaper       the host's wallpaper daemon owns the screen; Omarchy only
#                   records which image its theme wants
#
# Run from a theme-set hook. Safe to run twice.
set -uo pipefail

theme_dir="${OMARCHY_STATE:-$HOME/.local/state/omarchy}/current/theme"
palette="$theme_dir/colors.toml"
shell_toml="$theme_dir/shell.toml"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-guest"

[[ -d $theme_dir ]] || { echo "sem tema do Omarchy em $theme_dir" >&2; exit 0; }

hexkey() {  # hexkey <file> <key>
  sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\\?#\\([0-9A-Fa-f]\\{6\\}\\)\"\\?.*/\\1/p" "$1" 2>/dev/null |
    head -1 | tr 'A-F' 'a-f'
}

# ---------------------------------------------------------------------------
# 1. window border
# ---------------------------------------------------------------------------
# The theme DECLARES the border it wants, in a [hyprland] section of shell.toml.
# Deriving it from accent+foreground - which is what this did first - happens to
# match on some themes and is wrong on any theme that chose otherwise.
# The theme does not declare a colour, it declares the whole gradient - up to
# ten stops and an angle:
#
#   active-border = "#ad2222 #ad2222 ... #eceff2 ... 35deg"
#
# Reading only the first hex, which is what a plain key lookup gives you, throws
# away the highlight stop and the angle and renders a flat border. Take the lot.
grad_line() { sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\\(.*\\)\".*/\\1/p" "$1" 2>/dev/null | head -1; }

raw="$(grad_line "$shell_toml" active-border)"
stops="$(printf '%s' "$raw" | grep -oE '#[0-9A-Fa-f]{6}' | tr 'A-F' 'a-f')"
angle="$(printf '%s' "$raw" | grep -oE '[0-9]+deg' | head -1 | tr -d 'deg')"
[[ -n $angle ]] || angle=45

if [[ -z $stops ]]; then
  a="$(hexkey "$palette" accent)"; f="$(hexkey "$palette" foreground)"
  stops="$(printf '%s\n%s' "${a:-ffaa00}" "${f:-e0d4c2}")"
fi
muted="$(hexkey "$palette" color8)"; [[ -n $muted ]] || muted="$(hexkey "$palette" color7)"
[[ -n $muted ]] || muted="$(printf '%s' "$stops" | head -1)"
muted="${muted#\#}"  # o fallback vem de $stops, que ainda carrega o hash

# Sem o `#`: o grep devolve `#ad2222` e o Hyprland quer `rgba(ad2222ff)`.
# Deixar o hash dentro do rgba() da "invalid color" e o gradiente inteiro cai.
lua_stops="$(printf '%s' "$stops" | tr -d '#' | sed 's/^/"rgba(/; s/$/ff)"/' | paste -sd, -)"

if [[ -n $lua_stops ]]; then
  mkdir -p "$state_dir"
  # The gradient has to be a TABLE. `col.active_border = "rgba(..) rgba(..) 45deg"`
  # - the string that works in hyprland.conf - is rejected by the Lua API with
  # "invalid color".
  cat > "$state_dir/hypr-theme.lua" <<LUA
-- Gerado por omarchy-guest-theme-apply. Nao editar: reescrito a cada troca de
-- tema. Carregado no fim do looknfeel.lua para ganhar do tema do host.
hl.config({
	general = {
		col = {
			active_border = {colors = {${lua_stops}}, angle = ${angle}},
			inactive_border = {colors = {"rgba(${muted}aa)", "rgba(${muted}66)"}, angle = ${angle}},
		},
	},
})
LUA
  # `hyprctl keyword` does not work here: with the Lua parser it answers
  # "keyword can't work with non-legacy parsers. Use eval." Sending that to
  # /dev/null is how it failed silently for an hour - the file was right and the
  # live value never moved. `eval` on the generated file applies exactly what
  # the next reload will.
  if command -v hyprctl >/dev/null 2>&1; then
    erro="$(hyprctl eval "dofile(\"$state_dir/hypr-theme.lua\")" 2>&1)"
    [[ $erro == ok* ]] || echo "  borda:     nao aplicou ao vivo: $erro" >&2
  fi
  echo "  borda:     $(printf '%s' "$stops" | grep -c .) paradas, ${angle}deg"
fi

# ---------------------------------------------------------------------------
# 2. kitty
# ---------------------------------------------------------------------------
kitty_out="$HOME/.config/kitty/current-theme.conf"
theme_kitty="$theme_dir/kitty.conf"

if [[ -f $theme_kitty ]]; then
  # Only the colour keys. The theme's kitty.conf is a whole config - font,
  # opacity, padding - and copying it wholesale is exactly what Omarchy refuses
  # to do, for good reason.
  { echo "# Gerado por omarchy-guest-theme-apply a partir do tema do Omarchy."
    echo "# So as cores: o resto do kitty.conf do tema e config, nao paleta."
    grep -E '^(background|foreground|cursor|cursor_text_color|selection_background|selection_foreground|color[0-9]+|active_tab_|inactive_tab_|active_border_color|inactive_border_color|bell_border_color|url_color)' "$theme_kitty"
  } > "$kitty_out"
  origem="kitty.conf do tema"
elif [[ -f $palette ]]; then
  # A theme that ships only a palette still has everything kitty needs.
  { echo "# Gerado por omarchy-guest-theme-apply a partir do colors.toml."
    for k in background foreground cursor selection_background selection_foreground; do
      v="$(hexkey "$palette" "$k")"; [[ -n $v ]] && echo "$k #$v"
    done
    for i in $(seq 0 15); do
      v="$(hexkey "$palette" "color$i")"; [[ -n $v ]] && echo "color$i #$v"
    done
  } > "$kitty_out"
  origem="colors.toml"
else
  origem=""
fi

# Escrever o arquivo nao basta: nesta maquina ninguem o incluia, e as cores
# do terminal ficaram meses "aplicadas" num arquivo que o kitty nunca leu.
# O include vai no FIM do kitty.conf de proposito - a ultima definicao vence,
# e o dono do tema num guest deste projeto e o Omarchy.
kitty_conf="$HOME/.config/kitty/kitty.conf"
if [[ -n $origem && -f $kitty_conf ]] && ! grep -q 'current-theme.conf' "$kitty_conf"; then
  {
    echo ""
    echo "# Cores do tema do Omarchy (omarchy-guest-theme-apply)"
    echo "include current-theme.conf"
  } >> "$kitty_conf"
  echo "  kitty:     include adicionado ao kitty.conf (faltava)"
fi

if [[ -n $origem ]]; then
  # Kitty re-reads its config on SIGUSR1. No remote control needed, and it
  # reaches every window that is already open - writing the file alone changes
  # nothing in a running terminal, which is what "o kitty continua" looks like.
  pkill -USR1 -x kitty 2>/dev/null
  echo "  kitty:     $(grep -c . "$kitty_out") linhas de $origem, terminais recarregados"
fi

# ---------------------------------------------------------------------------
# 3. wallpaper
# ---------------------------------------------------------------------------
# Omarchy records which background its theme wants; on this machine the host's
# daemon is what actually paints it. Pointing the host at Omarchy's choice keeps
# one daemon and makes the wallpaper follow the theme.
#
# "Background", nao "imagem": desde "Add native video wallpaper support" (#6792)
# o current/background deles tambem pode ser video, que o shell deles pinta com
# um player proprio. O daemon do host pinta imagem. Entregar o .mp4 para ele nao
# da erro visivel - da tela preta e um wallpaper que parou de seguir o tema.
# Nesse caso caimos na primeira imagem do tema, que e o que o host consegue
# pintar, e dizemos por que.
is_video() { [[ ${1,,} =~ \.(mp4|m4v|mov|webm|mkv|avi)$ ]]; }

theme_image() {
  find "$theme_dir/backgrounds" -maxdepth 1 -type f \
    \( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' -o -name '*.webp' -o -name '*.bmp' \) \
    2>/dev/null | sort | head -1
}

# Antes de tudo: quem e o dono do fundo. Se o plugin `omarchy.background`
# esta ligado, o dono e o shell deles - ele le o current/background sozinho,
# inclusive video, e a tela de bloqueio deles le o mesmo arquivo. Chamar o
# daemon do host aqui, nesse caso, so cria um segundo dono para a mesma coisa,
# que e como esta maquina passou dias com o fundo do login trocando sozinho.
# O bloco continua aqui para o host que AINDA pinta - um guest onde o plugin
# foi desligado de proposito.
background_plugin_disabled() {
  local cfg="$HOME/.config/omarchy/shell.json"
  [[ -f $cfg ]] || return 1
  sed -n '/"disabledPlugins"/,/]/p' "$cfg" | grep -q '"omarchy\.background"'
}

# ATENCAO A ESTE `if`, e nao a um `exit`. Ate 16/09/2026 este bloco saia com
# `exit 0` quando o plugin era o dono - e como essa e a configuracao normal, ele
# fazia de QUALQUER secao adicionada abaixo codigo morto, nas duas maquinas, sem
# aviso. Descoberto ao acrescentar a secao 3.
if ! background_plugin_disabled; then
  echo "  wallpaper: dono e o plugin omarchy.background (segue o tema sozinho)"
else

bg="$(readlink -f "${OMARCHY_STATE:-$HOME/.local/state/omarchy}/current/background" 2>/dev/null)"
bg_video=""
if [[ -n $bg ]] && is_video "$bg"; then
  bg_video="$bg"
  bg=""
fi
if [[ -z $bg || ! -f $bg ]]; then
  bg="$(theme_image)"
fi

if [[ -n $bg && -f $bg ]]; then
  if [[ -x $HOME/.local/lib/hyde/wallpaper.sh ]]; then
    # -t: o Omarchy escolhe .webp com frequencia e o wallpaper.sh do HyDE nao
    # o tem na lista padrao - sem o override ele "nao encontra" o arquivo.
    "$HOME/.local/lib/hyde/wallpaper.sh" -t 'jpg:jpeg:png:gif:bmp:webp' --set "$bg" >/dev/null 2>&1 &&
      echo "  wallpaper: $(basename "$bg")"
  else
    echo "  wallpaper: sem wallpaper.sh do host; deixe o plugin omarchy.background ligado"
  fi
  if [[ -n $bg_video ]]; then
    echo "             (tema com video: $(basename "$bg_video"); o host so pinta imagem)"
  fi
elif [[ -n $bg_video ]]; then
  echo "  wallpaper: tema aponta para video ($(basename "$bg_video")) e nao ha imagem em"
  echo "             $theme_dir/backgrounds - wallpaper mantido como estava"
fi

fi  # fecha o `if ! background_plugin_disabled`

# ---------------------------------------------------------------------------
# 4. toolkit: icones, cursor e o nome do tema GTK
# ---------------------------------------------------------------------------
# O PROBLEMA e que nao ha um dono, e sim dois, lendo arquivos diferentes.
#
# O Omarchy escreve o icone em `gsettings org.gnome.desktop.interface
# icon-theme`, a partir do `icons.theme` que o tema declara. O host escreve
# `gtk-icon-theme-name` em ~/.config/gtk-3.0/settings.ini. Nenhum dos dois esta
# errado, e nenhum sabe do outro - entao o conjunto de icones fica partido ao
# meio pela LISTA DE APPS: GTK3 le o settings.ini e pega o do host, GTK4 e
# libadwaita leem o gsettings e pegam o do tema.
#
# Medido em 16/09/2026: gsettings `Yaru-blue` (o tema `ethereal` declara isso) e
# settings.ini `monochrome-icon-set` (do HyDE, de agosto). Nao ha erro em lugar
# nenhum, e nao ha como notar sem comparar os dois.
#
# Aqui o settings.ini passa a ESPELHAR o gsettings, e o tema vira o dono unico.
#
# CURSOR e TEMA GTK sao outra coisa, e vale dizer: o tema do Omarchy nao declara
# nenhum dos dois, entao nao ha o que derivar. Ficam valores do projeto, iguais
# em toda maquina - que e o que "unificado" pode significar aqui. `Adwaita-dark`
# como nome de tema GTK e deliberado: quem pinta a cor e o gtk.css do tema,
# quando ele traz um; um nome de tema de terceiro por cima disso e a terceira
# opiniao sobre a mesma janela.
cursor_theme="${OMARCHY_GUEST_CURSOR_THEME:-Bibata-Modern-Ice}"
cursor_size="${OMARCHY_GUEST_CURSOR_SIZE:-24}"
gtk_theme="${OMARCHY_GUEST_GTK_THEME:-Adwaita-dark}"

# Atualiza a chave se existir, acrescenta se nao - preservando o resto do
# arquivo. As outras chaves ali sao do usuario (fonte, antialiasing, hinting) e
# reescrever o arquivo inteiro levaria tudo junto.
ini_set() {  # ini_set <arquivo> <chave> <valor>
  local f="$1" k="$2" v="$3"
  [[ -f $f ]] || { mkdir -p "$(dirname "$f")"; printf '[Settings]\n' > "$f"; }
  grep -q '^\[Settings\]' "$f" || sed -i '1i [Settings]' "$f"
  if grep -q "^$k=" "$f"; then
    sed -i "s|^$k=.*|$k=$v|" "$f"
  else
    sed -i "/^\[Settings\]/a $k=$v" "$f"
  fi
}

icon_theme=""
[[ -f $theme_dir/icons.theme ]] && icon_theme="$(tr -d '[:space:]' < "$theme_dir/icons.theme")"

for gtkdir in gtk-3.0 gtk-4.0; do
  ini="$HOME/.config/$gtkdir/settings.ini"
  # Backup uma vez so, na primeira passada: recopiar a cada troca de tema
  # capturaria o arquivo ja reescrito como "original".
  [[ -f $ini && ! -f $state_dir/toolkit-orig/$gtkdir-settings.ini ]] && {
    mkdir -p "$state_dir/toolkit-orig"
    cp "$ini" "$state_dir/toolkit-orig/$gtkdir-settings.ini"
  }
  [[ -n $icon_theme ]] && ini_set "$ini" gtk-icon-theme-name "$icon_theme"
  ini_set "$ini" gtk-theme-name         "$gtk_theme"
  ini_set "$ini" gtk-cursor-theme-name  "$cursor_theme"
  ini_set "$ini" gtk-cursor-theme-size  "$cursor_size"
done

# O cursor do COMPOSITOR nao vem do settings.ini. Com XCURSOR_THEME por definir
# - e num guest cujo host exportava essa variavel ela some junto com ele - quem
# decide e ~/.icons/default/index.theme, por heranca. Sem esta parte o cursor
# fica no que o host tinha escolhido, e o settings.ini acima so moveria o cursor
# DENTRO dos apps GTK.
mkdir -p "$HOME/.icons/default"
cat > "$HOME/.icons/default/index.theme" <<CURSOR
[Icon Theme]
Name=Default
Comment=Default Cursor Theme
Inherits=$cursor_theme
CURSOR

gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-size  "$cursor_size"  2>/dev/null
# Ao vivo, para nao precisar de logout. Falha silenciosa fora de uma sessao.
hyprctl setcursor "$cursor_theme" "$cursor_size" >/dev/null 2>&1

echo "  toolkit:   icones ${icon_theme:-(tema nao declara)}, cursor $cursor_theme $cursor_size, gtk $gtk_theme"

# Este script roda como hook de theme-set: sair diferente de zero faz o
# omarchy-hook deles imprimir "Hook failed" a cada troca de tema.
exit 0

#!/usr/bin/env bash
# omarchy-guest - run the Omarchy shell as a guest, not as the owner.
#
# Only `doctor` exists so far, and it only reads. Nothing here writes to the
# system.
set -uo pipefail

VERSION="0.1.0"

# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; BLUE=$'\033[34m'
else
  BOLD=""; DIM=""; RESET=""; GREEN=""; YELLOW=""; RED=""; BLUE=""
fi

ok()      { printf '  %s+%s %s\n'  "$GREEN"  "$RESET" "$*"; }
warn()    { printf '  %s!%s %s\n'  "$YELLOW" "$RESET" "$*"; WARNS=$((WARNS+1)); }
bad()     { printf '  %sx%s %s\n'  "$RED"    "$RESET" "$*"; PROBS=$((PROBS+1)); }
info()    { printf '  %s-%s %s\n'  "$DIM"    "$RESET" "$*"; }
note()    { printf '      %s%s%s\n' "$DIM" "$*" "$RESET"; }
section() { printf '\n%s%s%s\n' "$BOLD" "$*" "$RESET"; }

WARNS=0
PROBS=0

have() { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -x "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
doctor() {
  printf '%somarchy-guest doctor%s  v%s\n' "$BOLD" "$RESET" "$VERSION"
  printf '%sread-only: this command changes nothing%s\n' "$DIM" "$RESET"

  # -- base ------------------------------------------------------------------
  section "Base"

  if [[ -f /etc/arch-release ]]; then
    ok "Arch-based system"
  else
    warn "not an Arch system - untested territory"
  fi

  if have Hyprland; then
    ok "Hyprland $(Hyprland --version 2>/dev/null | head -1 | awk '{print $2}')"
  else
    bad "Hyprland not found - the shell targets Hyprland"
  fi

  if have quickshell; then
    ok "quickshell present"
  else
    bad "quickshell not installed - the Omarchy shell IS a quickshell config"
    note "pacman -S quickshell (or the AUR build)"
  fi

  if have uwsm && [[ -n ${UWSM_FINALIZE_VARNAMES:-} ]]; then
    warn "session is managed by uwsm"
    note "whoever owns the entry point must call 'uwsm finalize', or systemd units"
    note "that need the display come up without knowing which screen to draw on"
  fi

  # -- omarchy itself --------------------------------------------------------
  section "Omarchy"

  local omarchy_path=""
  for candidate in "${OMARCHY_PATH:-}" "$HOME/.local/share/omarchy" /usr/share/omarchy; do
    [[ -n $candidate && -d $candidate ]] || continue
    omarchy_path="$candidate"
    break
  done

  if [[ -n $omarchy_path ]]; then
    ok "found at $omarchy_path"
    if [[ -z ${OMARCHY_PATH:-} ]]; then
      warn "OMARCHY_PATH is not exported in this environment"
      note "their Lua falls back to /usr/share/omarchy; a checkout elsewhere is not found"
      note "fix: OMARCHY_PATH=$omarchy_path in ~/.config/environment.d/"
    else
      ok "OMARCHY_PATH=$OMARCHY_PATH"
    fi
    [[ -d $omarchy_path/shell ]] && ok "shell sources present" || bad "no shell/ in $omarchy_path"
    [[ -f $omarchy_path/default/hypr/helpers.lua ]] \
      && ok "helper table 'o' available to load standalone" \
      || warn "default/hypr/helpers.lua missing - the 'o' shim will not work"
    if [[ ":$PATH:" != *":$omarchy_path/bin:"* ]]; then
      warn "$omarchy_path/bin is not on PATH"
      note "their commands call each other by bare name; without this, a shell"
      note "restart kills the bar and cannot bring it back"
    else
      ok "their bin/ is on PATH"
    fi

    # Contrato: quanto do upstream mudou desde a ultima vez que este repo foi
    # conferido. Nao busca na rede - so le o que ja foi baixado; um doctor que
    # sai para a internet mente sobre o custo de rodar.
    if git -C "$omarchy_path" rev-parse --git-dir >/dev/null 2>&1; then
      local pinned="" upstream="" ahead=""
      [[ -f $REPO/contract/verified ]] && pinned=$(awk -F= '$1=="ref"{print $2}' "$REPO/contract/verified" | tr -d ' ')
      upstream=$(git -C "$omarchy_path" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
      if [[ -n $pinned && -n $upstream ]]; then
        ahead=$(git -C "$omarchy_path" rev-list --count --no-merges "$pinned..$upstream" 2>/dev/null)
        if [[ ${ahead:-0} -gt 0 ]]; then
          warn "$ahead commits deles desde o ref conferido ($upstream)"
          note "omarchy-guest-contract --ref $upstream --commits"
        else
          ok "upstream na altura do ref conferido em contract/verified"
        fi
      fi
    fi
  else
    bad "no Omarchy checkout found"
    note "clone it, or install the package, then re-run"
  fi

  # -- runtime deps ----------------------------------------------------------
  # O instalador deles traria ~150 pacotes; um guest quer so o que o shell e
  # os comandos do menu invocam em runtime. Lista curada do que ja quebrou de
  # verdade numa instalacao guest, com o recurso que cada falta leva junto.
  section "Runtime deps (o instalador deles teria trazido)"
  local dep_missing=()
  local dep pkg what
  for spec in     "gum:gum:plugin add, confirmacoes, e a moldura dos terminais do menu"     "xdg-terminal-exec:xdg-terminal-exec:toda linha de menu que abre um terminal"     "uwsm-app:uwsm:idem - o launcher deles passa por uwsm-app"     "qrencode:qrencode:painel Wi-Fi QR (omarchy.wifiqr)"     "wtype:wtype:colar arquivo do clipboard (omarchy.clipboard)"; do
    dep="${spec%%:*}"; pkg="${spec#*:}"; pkg="${pkg%%:*}"; what="${spec##*:}"
    if have "$dep"; then
      ok "$dep"
    else
      warn "$dep falta - quebra: $what"
      dep_missing+=("$pkg")
    fi
  done
  if (( ${#dep_missing[@]} > 0 )); then
    note "fix: sudo pacman -S --needed ${dep_missing[*]}"
  fi

  # -- who owns the entry point ---------------------------------------------
  section "Compositor config ownership"

  local entry="${HYPRLAND_CONFIG:-}"
  if [[ -n $entry ]]; then
    # A variavel manda, mas para ONDE ela aponta e a pergunta toda. Apontando
    # para um arquivo seu, a posse esta invertida e isto e uma boa noticia -
    # dizer "so uma camada de override" aqui seria mentira, e e exatamente o
    # que este comando existe para nao fazer.
    if [[ $entry == "$HOME/.config/"* ]]; then
      ok "entry point: $entry"
      note "aponta para um arquivo seu: a posse do compositor esta com voce"
      if grep -q 'default/hypr/bootstrap.lua' "$entry" 2>/dev/null; then
        ok "e esse arquivo carrega a cadeia do Omarchy"
      else
        warn "mas esse arquivo nao carrega a cadeia do Omarchy"
        note "confira o dofile de \$OMARCHY_PATH/default/hypr/bootstrap.lua"
      fi
    else
      warn "HYPRLAND_CONFIG=$entry"
      note "this wins over ~/.config/hypr/. Editing hyprland.lua/conf does NOT"
      note "change what loads first - that file is only an override layer."
      note "inverter a posse e apontar esta variavel para um arquivo seu;"
      note "num host com uwsm, em ~/.config/uwsm/env-<compositor>.d/ - o"
      note "environment.d nao chega la (ver hypr/README.md)"
    fi
  else
    if [[ -f $HOME/.config/hypr/hyprland.lua ]]; then
      entry="$HOME/.config/hypr/hyprland.lua"
      ok "entry point: ~/.config/hypr/hyprland.lua (Lua config)"
    elif [[ -f $HOME/.config/hypr/hyprland.conf ]]; then
      entry="$HOME/.config/hypr/hyprland.conf"
      ok "entry point: ~/.config/hypr/hyprland.conf (classic config)"
    else
      bad "no Hyprland config found in ~/.config/hypr/"
    fi
  fi

  # known config managers that take the entry point for themselves
  local manager=""
  [[ -d $HOME/.local/share/hypr && -f $HOME/.local/share/hypr/hyde.lua ]] && manager="HyDE"
  [[ -d $HOME/.config/ml4w ]] && manager="${manager:+$manager, }ML4W"
  [[ -d $HOME/.config/hypr/UserConfigs ]] && manager="${manager:+$manager, }JaKooLit"
  [[ -d $HOME/.config/ags && -d $HOME/.config/hypr/hyprland ]] && manager="${manager:+$manager, }end-4"

  if [[ -n $manager ]]; then
    warn "another config manager is installed: $manager"
    note "expect it to own the entry point and to start its own bar and daemons"
  else
    ok "no known third-party Hyprland config manager detected"
  fi

  # is the 'o' table reachable in the running session?
  if have hyprctl && hyprctl version >/dev/null 2>&1; then
    local probe="${XDG_RUNTIME_DIR:-/tmp}/omarchy-guest-probe.$$"
    hyprctl eval "local f=io.open(\"$probe\",\"w\") f:write(tostring(o ~= nil)..\" \"..tostring(package and package.loaded and package.loaded[\"default.hypr.omarchy\"] ~= nil)) f:close() return true" >/dev/null 2>&1
    if [[ -f $probe ]]; then
      read -r has_o has_chain < "$probe"; rm -f "$probe"
      [[ $has_o == "true" ]] && ok "helper table 'o' is defined in the running session" \
                              || warn "helper table 'o' is NOT defined - Omarchy plugins calling o.bind will die"
      [[ $has_chain == "true" ]] && ok "Omarchy's Hyprland chain is loaded" \
                                  || info "Omarchy's Hyprland chain is not loaded (fine for shell-only use)"
    else
      info "could not probe the running session (Lua config not in use?)"
    fi
  else
    info "no running Hyprland session to probe"
  fi

  # -- what is already running ----------------------------------------------
  section "Collisions with what you already run"

  local bars=()
  for b in waybar ags eww; do running "$b" && bars+=("$b"); done
  running quickshell && bars+=("quickshell")
  if (( ${#bars[@]} > 1 )); then
    bad "more than one bar is running: ${bars[*]}"
    note "the Omarchy shell IS the quickshell one; disable the host's bar"
  elif (( ${#bars[@]} == 1 )); then
    ok "one bar running: ${bars[0]}"
  else
    info "no bar running"
  fi

  local notif=()
  for n in dunst mako swaync; do running "$n" && notif+=("$n"); done
  if (( ${#notif[@]} > 0 )); then
    warn "notification daemon running: ${notif[*]}"
    note "the Omarchy shell has its own; running both doubles every notification"
  else
    ok "no competing notification daemon"
  fi

  # Um daemon parado ainda volta por ativacao D-Bus: o pacote instala um
  # service file reivindicando org.freedesktop.Notifications e o primeiro
  # notify-send do boot o ressuscita antes do shell registrar o nome - sem
  # erro em lugar nenhum, as notificacoes so vao para o daemon errado.
  # Visto no primeiro boot real como guest, com o dunst.service do Arch.
  local svc dbus_unit
  for svc in /usr/share/dbus-1/services/*.service; do
    [[ -f $svc ]] || continue
    grep -q '^Name=org.freedesktop.Notifications$' "$svc" || continue
    dbus_unit="$(sed -n 's/^SystemdService=//p' "$svc" | head -1)"
    if [[ -n $dbus_unit && "$(systemctl --user is-enabled "$dbus_unit" 2>/dev/null)" == "masked" ]]; then
      ok "dbus activation de notificacoes mascarada ($(basename "$svc"))"
    else
      warn "$(basename "$svc") reivindica org.freedesktop.Notifications por D-Bus"
      note "suprimir o autostart do host nao basta: o primeiro notify-send do boot"
      note "ressuscita o daemon. fix: systemctl --user mask ${dbus_unit:-<a unit do daemon>}"
    fi
  done

  for pair in "hypridle:idle daemon" "hyprlock:lock screen" "swayidle:idle daemon" "swaylock:lock screen"; do
    local proc="${pair%%:*}" what="${pair#*:}"
    running "$proc" && info "host $what: $proc"
  done

  if running hyprpolkitagent || running polkit-kde-authentication-agent-1 || running polkit-gnome-authentication-agent-1; then
    ok "a polkit agent is running"
  else
    warn "no polkit agent detected - GUI password prompts will fail silently"
  fi

  # -- lock screen -----------------------------------------------------------
  section "Lock screen"

  if [[ -f /etc/pam.d/omarchy-lock-password ]]; then
    ok "/etc/pam.d/omarchy-lock-password exists"
  else
    warn "/etc/pam.d/omarchy-lock-password missing"
    note "the Omarchy lock screen cannot authenticate without it"
    note "fix: omarchy-apply-lock   (needs root, writes the PAM files)"
    note "or keep your host's lock screen and leave omarchy.lock disabled"
  fi

  # O arquivo PAM e a metade barata. A que engana e o GATILHO: ligar o plugin
  # nao move quem chama o lock. O plugin nao escuta o logind, entao SUPER+L, a
  # linha Lock do menu e o suspend continuam caindo no locker do host ate que
  # o daemon de idle DELE aponte para ca.
  local lock_disabled=""
  if [[ -f $HOME/.config/omarchy/shell.json ]]; then
    lock_disabled=$(sed -n '/"disabledPlugins"/,/]/p' "$HOME/.config/omarchy/shell.json" | grep -c '"omarchy\.lock"')
  fi
  if [[ ${lock_disabled:-0} -gt 0 ]]; then
    info "omarchy.lock is disabled - the host's lock screen is the one in use"
  else
    ok "omarchy.lock is enabled"
    local lock_cmd=""
    if [[ -f $HOME/.config/hypr/hypridle.conf ]]; then
      lock_cmd=$(grep -m1 -E '^[[:space:]]*lock_cmd' "$HOME/.config/hypr/hypridle.conf" | sed 's/#.*//; s/^[[:space:]]*lock_cmd[[:space:]]*=[[:space:]]*//')
      if [[ $lock_cmd == *omarchy* ]]; then
        ok "the host's idle daemon locks with Omarchy: $lock_cmd"
      elif [[ -n $lock_cmd ]]; then
        warn "the plugin is on, but the lock trigger still goes to the host: $lock_cmd"
        note "the plugin does not listen to logind - SUPER+L, the menu's Lock row and"
        note "suspend all route through the host's idle daemon, so the lock screen you"
        note "get is whatever this line says"
        note "test first: omarchy-shell lock lock   (while the host's locker still works)"
      fi
    else
      info "no hypridle.conf here - check what your host binds to lock-session"
    fi
  fi

  # -- first-run deles -------------------------------------------------------
  #
  # So aparece depois que a posse inverte: com o Omarchy na raiz, o autostart
  # deles chama `omarchy-provision-first-run`, que instala hooks, aplica tema
  # GTK, afina o alto-falante e agenda a notificacao "Update System" - a que
  # abre o updater COMPLETO deles, o que num guest e justamente o que nao se
  # quer. E ele so marca "feito" se TODO passo passar; um passo que falha faz
  # tudo repetir no proximo login, notificacao inclusive.
  section "First-run deles"
  if [[ -f $HOME/.local/state/omarchy/done/first-run-user ]]; then
    ok "first-run marcado como feito (nao repete a cada login)"
  else
    local units_faltando=()
    local unit
    for unit in bt-agent omarchy-recover-internal-monitor omarchy-sleep-lock \
                omarchy-migrate-notify omarchy-fcitx5 omarchy-crash-watch; do
      systemctl --user cat "$unit.service" >/dev/null 2>&1 || units_faltando+=("$unit")
    done
    if (( ${#units_faltando[@]} > 0 )); then
      warn "first-run vai repetir a cada login: ${#units_faltando[@]} unit(s) de systemd faltando"
      note "sao units EMPACOTADOS deles (/usr/lib/systemd/user); num checkout nao existem"
      note "faltando: ${units_faltando[*]}"
      note "os que tem binario, copie de \$OMARCHY_PATH/default/systemd/user/ para"
      note "~/.config/systemd/user/ e habilite; os outros nao tem como funcionar"
      note "depois: omarchy-done mark first-run-user   (para de repetir)"
    else
      info "first-run ainda nao marcado; roda no proximo login"
    fi
  fi

  # -- browser theme ---------------------------------------------------------
  # A cor do tema no browser tem uma metade privilegiada que roda sempre do
  # caminho empacotado (/usr/bin), porque a regra de sudoers casa esse caminho
  # exato. Num checkout ela nao existe, e toda troca de tema reclama.
  section "Browser theme"
  local browser_found=""
  for b in chromium google-chrome-stable google-chrome microsoft-edge-stable brave; do
    have "$b" && { browser_found="$b"; break; }
  done
  if [[ -n $browser_found ]]; then
    if [[ -x /usr/bin/omarchy-theme-set-browser-policy && -f /etc/sudoers.d/omarchy-theme-browser ]]; then
      ok "escrita privilegiada instalada ($browser_found sera pintado)"
    else
      warn "$browser_found presente, mas a metade root do tema de browser falta"
      note "num checkout, /usr/bin/omarchy-theme-set-browser-policy nao existe e a"
      note "troca de tema reclama. fix: sudo omarchy-guest-apply-browser-policy"
    fi
  else
    info "nenhum browser da familia Chromium - nada a pintar"
  fi

  # -- what their autostart would launch -------------------------------------
  if [[ -n $omarchy_path && -f $omarchy_path/default/hypr/autostart.lua ]]; then
    section "What Omarchy's autostart would start"
    grep -oE 'exec_cmd\((o\.launch\()?"[^"]+"' "$omarchy_path/default/hypr/autostart.lua" 2>/dev/null \
      | sed -E 's/.*"([^"]+)".*/\1/' | while read -r cmd; do
        first="${cmd%% *}"; first="${first##*/}"
        # systemctl/dbus/sleep sao encanamento de sessao, nao daemon: acusar
        # "ja rodando" neles e ruido, porque estao sempre de pe.
        case "$first" in
          systemctl|dbus-update-activation-environment|sleep|env|true)
            info "$cmd  (session plumbing)"; continue ;;
        esac
        if running "$first"; then
          warn "$cmd  (already running here)"
        else
          info "$cmd"
        fi
      done
    note "as a guest you usually want only the shell from this list; the rest is"
    note "your host's job and starting it twice is the classic guest bug"
  fi

  # -- verdict ---------------------------------------------------------------
  # --- caminho de atualizacao ---------------------------------------------
  #
  # A checagem mais importante deste doctor, e a que nasceu por ultimo.
  #
  # O menu do Omarchy tem uma linha `update.omarchy` que chama `omarchy-update`:
  # ela atualiza o sistema do jeito DELES, com migrations, e numa maquina que e
  # um flavor isso passa por cima de decisoes que o flavor tomou. A extensao de
  # menu troca essa linha pelo nosso atualizador e desliga os quatro
  # `update.channel.*`, porque trocar de canal termina em `omarchy-update -y`
  # com migrations inclusas - ou seja, o caminho perigoso por um atalho lateral.
  #
  # Isso sempre esteve documentado (docs/MENU-OVERRIDES.md) e sempre foi COPIADO
  # pelo install. O que faltava era alguem CONFERIR que a copia aconteceu: uma
  # instalacao pela metade deixava o caminho normal vivo, em silencio, e o
  # sintoma so aparece no dia em que alguem clica em "Update" no menu.
  section "Caminho de atualizacao"
  local ext="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
  if [[ ! -f $ext ]]; then
    bad "a extensao de menu nao esta instalada"
    note "o menu do Omarchy esta com o caminho de update ORIGINAL vivo"
    note "conserto: omarchy-guest install"
  else
    ok "extensao de menu instalada"
    if grep -q '"update\.omarchy"' "$ext"; then
      ok "update.omarchy trocado pelo atualizador do flavor"
    else
      bad "update.omarchy NAO esta sobrescrito - o menu chama omarchy-update"
    fi
    local canais_abertos=0 c
    for c in stable rc edge dev; do
      grep -q "\"update\.channel\.$c\"" "$ext" || canais_abertos=1
    done
    if ((canais_abertos)); then
      bad "algum update.channel.* nao esta desligado"
      note "trocar de canal termina em \`omarchy-update -y\`, com migrations"
    else
      ok "os quatro update.channel.* desligados"
    fi
  fi
  local upd="$HOME/.local/share/omarchy-guest/updater/system.update.py"
  if [[ -f ${OMARCHY_GUEST_UPDATER:-} || -f $upd ]]; then
    ok "atualizador do flavor no lugar"
  else
    bad "o atualizador do flavor nao esta instalado"
    note "a linha de menu trocada cairia no do host, ou em nada"
  fi

  section "Verdict"
  if (( PROBS > 0 )); then
    printf '  %s%d blocker(s)%s and %d warning(s).\n' "$RED" "$PROBS" "$RESET" "$WARNS"
  elif (( WARNS > 0 )); then
    printf '  %sno blockers%s, %d thing(s) to decide.\n' "$GREEN" "$RESET" "$WARNS"
  else
    printf '  %sclean%s - nothing here would collide.\n' "$GREEN" "$RESET"
  fi
  printf '  %sThe map of every assumption is in docs/ASSUMPTIONS.md%s\n' "$DIM" "$RESET"
  echo
}

# ---------------------------------------------------------------------------
# install - copy this repo's pieces into place
# ---------------------------------------------------------------------------
#
# Copies, does not symlink. The shell scans the plugin directory and watches it
# for changes; a symlinked tree is one more thing that can behave differently
# between machines, and this has to work on a machine we are not sitting at.
#
# Every destination is backed up first, with a timestamp.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Backups vao para FORA do diretorio de origem, sempre.
#
# A primeira versao gravava `<alvo>.bak.<data>` ao lado do alvo. Para
# ~/.config/omarchy/plugins isso e lixo dentro de uma pasta que o shell varre e
# observa: cada backup vira um candidato a plugin com o MESMO id do manifesto
# do original. O carregador aqui ignorou, mas depender disso e sorte.
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-guest/backups"

backup() {
  local target="$1"
  [[ -e $target ]] || return 0
  local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
  local dest="$BACKUP_DIR/$stamp"
  mkdir -p "$dest"
  cp -r "$target" "$dest/"
  info "backup: $dest/$(basename "$target")"
}

install_all() {
  local dry=0
  [[ ${1:-} == "--dry-run" ]] && dry=1

  printf '%somarchy-guest install%s%s\n' "$BOLD" "$RESET" \
    "$( ((dry)) && printf '  (dry run)' )"

  section "Shell plugins"
  local dest="$HOME/.config/omarchy/plugins"
  for plugin in "$REPO"/plugins/*/; do
    [[ -d $plugin ]] || continue
    local name; name="$(basename "$plugin")"
    if ((dry)); then info "would install $name -> $dest/$name"; else
      mkdir -p "$dest"; backup "$dest/$name"
      cp -r "$plugin" "$dest/"
      ok "$name"
    fi
  done

  section "Menu extension"
  local ext="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
  if [[ -f $REPO/extensions/omarchy-menu.jsonc ]]; then
    if ((dry)); then info "would install $ext"; else
      mkdir -p "$(dirname "$ext")"; backup "$ext"
      cp "$REPO/extensions/omarchy-menu.jsonc" "$ext"
      ok "omarchy-menu.jsonc"
      warn "review it before trusting it - the hidden rows are chosen for the"
      note "reference machine, and your host owns different files"
    fi
  fi

  section "Updater"
  local udest="$HOME/.local/share/omarchy-guest/updater"
  if [[ -d $REPO/vendor/hyde-updater ]]; then
    if ((dry)); then info "would install updater -> $udest"; else
      mkdir -p "$udest"; backup "$udest"
      cp -r "$REPO"/vendor/hyde-updater/. "$udest/"
      rm -rf "$udest/__pycache__" "$udest/package_managers/__pycache__"
      ok "system.update.py + pm.py + package_managers/ (GPL-3, ver NOTICE.md)"
      note "o widget e o menu procuram nesta ordem: \$OMARCHY_GUEST_UPDATER,"
      note "$udest, e por ultimo o do HyDE"
    fi
  fi

  section "Collector"
  local bdest="$HOME/.local/share/omarchy-guest/bin"
  for helper in omarchy-guest-graph omarchy-guest-theme-apply omarchy-guest-theme-boot omarchy-guest-run omarchy-guest-launch-shell omarchy-guest-apply-browser-policy; do
    [[ -x $REPO/bin/$helper ]] || continue
    if ((dry)); then info "would install $helper -> $bdest"; else
      mkdir -p "$bdest"
      cp "$REPO/bin/$helper" "$bdest/"
      chmod +x "$bdest/$helper"
      ok "$helper"
    fi
  done

  section "Shims (na frente do bin/ deles, via omarchy-guest-run)"
  local sdest="$HOME/.local/share/omarchy-guest/shims"
  for shim in "$REPO"/shims/*; do
    [[ -f $shim ]] || continue
    local sname; sname="$(basename "$shim")"
    if ((dry)); then info "would install $sname -> $sdest"; else
      mkdir -p "$sdest"
      cp "$shim" "$sdest/"
      chmod +x "$sdest/$sname"
      ok "$sname"
    fi
  done
  note "so valem para processos lancados por omarchy-guest-run / launch-shell;"
  note "um terminal que chama o comando pelo nome ainda cai no original deles"

  section "Hooks"
  # O README sempre prometeu isto; a primeira versao do install esquecia de
  # copiar, e o theme-set.d so funcionava na maquina onde foi escrito a mao.
  local hdest="$HOME/.config/omarchy/hooks"
  for hookd in "$REPO"/hooks/*/; do
    [[ -d $hookd ]] || continue
    local hname; hname="$(basename "$hookd")"
    if ((dry)); then info "would install $hname -> $hdest/$hname"; else
      mkdir -p "$hdest/$hname"
      for hf in "$hookd"*; do
        [[ -f $hf ]] || continue
        backup "$hdest/$hname/$(basename "$hf")"
        cp "$hf" "$hdest/$hname/"
        chmod +x "$hdest/$hname/$(basename "$hf")"
        ok "$hname/$(basename "$hf")"
      done
    fi
  done

  section "Quadro"
  local qdir="$HOME/.local/share/omarchy-guest/quadro"
  if [[ -d $REPO/quadro ]]; then
    if ((dry)); then info "would seed $qdir with the starter documents"; else
      mkdir -p "$qdir"
      for f in "$REPO"/quadro/*.md; do
        [[ -f $f ]] || continue
        # nao sobrescreve documento que ja existe: a pasta e do usuario, e o
        # que esta la pode ter sido escrito depois.
        if [[ -e "$qdir/$(basename "$f")" ]]; then
          info "$(basename "$f") ja existe, mantido"
        else
          cp "$f" "$qdir/"; ok "$(basename "$f")"
        fi
      done
    fi
  fi

  section "Hyprland snippets"
  info "hypr/*.lua are NOT copied: where they belong depends on who owns your"
  note "entry point. See docs/HOST-INVENTORY.md before wiring them in."

  if ((dry)); then
    echo; info "nothing was written"
  else
    section "Next"
    info "omarchy restart shell   # saving alone does not rebuild live widgets"
  fi
  echo
}

# ---------------------------------------------------------------------------
# bootstrap - de um Arch com Hyprland ate este flavor
# ---------------------------------------------------------------------------
#
# O contrato de entrada: a pessoa instala o Arch, instala o Hyprland, clona este
# repo e roda isto. Nada aqui precisa de sessao grafica - roda inteiro de um
# TTY, que e o unico lugar que existe antes do primeiro login.
#
# O que precisa de sessao viva e conferencia, nao instalacao, e por isso mora no
# `doctor`: `hyprctl` so responde com o compositor de pe, e a config que este
# comando escreve e justamente a que o Hyprland vai ler NO PROXIMO login.
#
# Idempotente de proposito. Rodar de novo depois de um `omarchy update`, ou numa
# maquina meio pronta, tem de ser seguro - e assim ele tambem serve de conserto,
# nao so de instalacao.

OMARCHY_REPO="https://github.com/basecamp/omarchy.git"
OMARCHY_REF="quattro"
OMARCHY_DIR="$HOME/.local/share/omarchy"

# `yay` cobre repo e AUR num comando so, e e o que o proprio tooling deles usa
# (bin/omarchy-pkg-aur-install). Sem helper de AUR, o pacman resolve a maior
# parte e o que faltar e listado para a pessoa decidir - melhor do que instalar
# metade e chamar de pronto.
aur_helper() {
  local h
  for h in yay paru pikaur; do command -v "$h" >/dev/null && { echo "$h"; return 0; }; done
  return 1
}

bootstrap_all() {
  local dry=0
  [[ ${1:-} == "--dry-run" ]] && dry=1
  local run=(); ((dry)) && run=(echo "       #")

  printf '%somarchy-guest bootstrap%s%s\n' "$BOLD" "$RESET" \
    "$( ((dry)) && printf '  (dry run)' )"

  # --- 1. preflight -------------------------------------------------------
  section "Preflight"
  local parada=0
  if [[ ! -f /etc/arch-release ]]; then
    warn "isto nao parece Arch - o instalador so sabe pacman"; parada=1
  else ok "Arch"; fi
  if [[ $EUID -eq 0 ]]; then
    warn "nao rode como root: a config vai para o \$HOME de quem roda"; parada=1
  else ok "usuario $USER"; fi
  command -v sudo >/dev/null && ok "sudo" || { warn "sem sudo"; parada=1; }
  if ping -c1 -W2 archlinux.org >/dev/null 2>&1; then ok "rede"
  else warn "sem rede - nada abaixo funciona"; parada=1; fi
  ((parada)) && { echo; warn "preflight falhou, nada foi feito"; return 1; }

  # --- 2. helper de AUR ---------------------------------------------------
  section "Helper de AUR"
  local PKG; PKG="$(aur_helper)" || true
  if [[ -n ${PKG:-} ]]; then
    ok "$PKG"
  else
    warn "nenhum helper de AUR (yay/paru/pikaur)"
    note "parte da lista base do Omarchy vem do AUR e sera apenas listada"
    note "para instalar o yay: sudo pacman -S --needed git base-devel &&"
    note "  git clone https://aur.archlinux.org/yay.git && cd yay && makepkg -si"
    PKG=""
  fi

  # --- 3. Hyprland --------------------------------------------------------
  section "Hyprland"
  if command -v Hyprland >/dev/null || command -v hyprctl >/dev/null; then
    ok "ja instalado"
  else
    info "faltando - instalando"
    "${run[@]}" sudo pacman -S --needed --noconfirm hyprland || {
      warn "falhou ao instalar o hyprland"; return 1; }
  fi

  # --- 4. Omarchy ---------------------------------------------------------
  section "Omarchy"
  if [[ -d $OMARCHY_DIR/.git ]]; then
    local atual; atual="$(git -C "$OMARCHY_DIR" rev-parse --short HEAD 2>/dev/null)"
    ok "ja clonado em $OMARCHY_DIR ($atual)"
    note "este comando NAO atualiza o clone: quem decide quando o upstream entra"
    note "e voce, depois de rodar \`omarchy-guest-contract\` contra o ref novo"
  else
    info "clonando $OMARCHY_REPO ($OMARCHY_REF)"
    "${run[@]}" git clone --branch "$OMARCHY_REF" "$OMARCHY_REPO" "$OMARCHY_DIR" || {
      warn "falhou ao clonar"; return 1; }
    ok "$OMARCHY_DIR"
  fi

  # --- 5. pacotes ---------------------------------------------------------
  section "Pacotes"
  # A lista base NAO e copiada para este repo: ela e do upstream e muda com ele.
  # Ler do clone e o que mantem os dois em dia sem ninguem sincronizar nada.
  local base="$OMARCHY_DIR/install/omarchy-base.packages"
  local delta="$REPO/system/packages/flavor.packages"
  local querem=() falta=()
  [[ -f $base  ]] && mapfile -t -O "${#querem[@]}" querem < <(grep -vE '^\s*(#|$)' "$base" | awk '{print $1}')
  [[ -f $delta ]] && mapfile -t -O "${#querem[@]}" querem < <(grep -vE '^\s*(#|$)' "$delta" | awk '{print $1}')
  if ((${#querem[@]} == 0)); then
    warn "nao achei lista de pacotes - pulando"
  else
    local p
    for p in "${querem[@]}"; do
      pacman -Qq "$p" >/dev/null 2>&1 || falta+=("$p")
    done
    info "${#querem[@]} pacotes na lista, ${#falta[@]} faltando"
    if ((${#falta[@]} == 0)); then
      ok "nada a instalar"
    elif [[ -n $PKG ]]; then
      # Um comando so: resolver dependencia em lote e muito mais rapido, e uma
      # falha no meio deixa um estado mais facil de entender do que 87 falhas
      # independentes.
      "${run[@]}" "$PKG" -S --needed --noconfirm "${falta[@]}" || {
        warn "algum pacote falhou - rode de novo, e idempotente"; }
    else
      warn "sem helper de AUR, instalando so o que estiver nos repos:"
      local repo_pk=() aur_pk=()
      for p in "${falta[@]}"; do
        if pacman -Si "$p" >/dev/null 2>&1; then repo_pk+=("$p"); else aur_pk+=("$p"); fi
      done
      ((${#repo_pk[@]})) && "${run[@]}" sudo pacman -S --needed --noconfirm "${repo_pk[@]}"
      if ((${#aur_pk[@]})); then
        warn "${#aur_pk[@]} pacotes so existem no AUR e NAO foram instalados:"
        note "  ${aur_pk[*]}"
      fi
    fi
  fi

  # --- 6. o resto ---------------------------------------------------------
  section "Proximos passos"
  if ((dry)); then
    info "nada foi escrito"
    info "depois: omarchy-guest install   (plugins, hooks, updater - sem sudo)"
    info "depois: omarchy-guest system    (splash, sddm, /etc/issue - com sudo)"
  else
    info "agora rode, nesta ordem:"
    info "  omarchy-guest install    # a metade do \$HOME, sem sudo"
    info "  omarchy-guest system     # splash, login e TTY, com sudo"
    echo
    info "e entao DESLOGUE e entre de novo - reload nao re-dispara session start,"
    note "entao so um login de verdade mostra o que este flavor faz."
    info "ja dentro da sessao nova: omarchy-guest doctor"
  fi
  echo
}

# ---------------------------------------------------------------------------
# system - a metade que mora fora do $HOME
# ---------------------------------------------------------------------------
#
# Tudo aqui precisa de root, e por isso e subcomando PROPRIO e nao um passo do
# `install`. O `install` continua sendo o que ele sempre foi: copia para dentro
# do $HOME, sem sudo, e quem rodar so ele nao tem o sistema tocado.
#
# Esta metade e a identidade que aparece ANTES do login - splash, tela de login,
# TTY - e e a diferenca entre "o shell de outra pessoa rodando aqui" e um flavor.
#
# Tudo e backupeado antes, no MESMO lugar dos backups do install, e o
# `system --undo` desfaz na ordem inversa lendo de la.

SYSTEM_BACKUP="$BACKUP_DIR/system"

# Um `sudo` por acao, em vez de um `sudo -v` no comeco: o script fica legivel no
# `--dry-run`, cada linha diz exatamente o que vai rodar como root, e nao ha
# janela de credencial aberta enquanto o resto trabalha.
sysrun() {
  if ((SYS_DRY)); then
    printf '       %s# sudo %s%s\n' "$DIM" "$*" "$RESET"
    return 0
  fi
  sudo "$@"
}

sysbackup() {
  local target="$1"
  [[ -e $target ]] || { info "$target nao existe, nada a salvar"; return 0; }
  local stamp; stamp="$SYS_STAMP"
  local dest="$SYSTEM_BACKUP/$stamp"
  if ((SYS_DRY)); then info "would back up $target -> $dest/"; return 0; fi
  mkdir -p "$dest"
  sudo cp -a "$target" "$dest/"
  sudo chown -R "$USER" "$dest"
  info "backup: $dest/$(basename "$target")"
}

system_all() {
  SYS_DRY=0
  [[ ${1:-} == "--dry-run" ]] && SYS_DRY=1
  SYS_STAMP="$(date +%Y%m%d-%H%M%S)"

  printf '%somarchy-guest system%s%s\n' "$BOLD" "$RESET" \
    "$( ((SYS_DRY)) && printf '  (dry run)' )"

  if ((!SYS_DRY)) && [[ $EUID -eq 0 ]]; then
    warn "nao rode isto como root: o backup vai para o \$HOME do usuario e o"
    note "sudo e pedido por acao. Rode como voce mesmo."
    return 1
  fi

  section "Splash do boot (plymouth)"
  if [[ ! -d $REPO/system/plymouth ]]; then
    info "nada em system/plymouth, pulando"
  elif ! command -v plymouth-set-default-theme >/dev/null; then
    warn "plymouth nao esta instalado - o tema seria copiado e nao usado"
    note "instale com: sudo pacman -S plymouth"
  else
    for theme in "$REPO"/system/plymouth/*/; do
      [[ -d $theme ]] || continue
      local tname; tname="$(basename "$theme")"
      sysbackup "/usr/share/plymouth/themes/$tname"
      sysrun mkdir -p "/usr/share/plymouth/themes/$tname"
      sysrun cp -r "$theme." "/usr/share/plymouth/themes/$tname/"
      ok "tema $tname copiado"
      # `-R` regenera o initramfs, que e onde o tema realmente vive: sem isso
      # ele esta em /usr/share e o boot continua mostrando o antigo.
      sysrun plymouth-set-default-theme -R "$tname"
      ok "tema $tname ativo (initramfs regenerado)"
    done
  fi

  section "Tela de login (sddm)"
  if [[ ! -f $REPO/system/sddm/theme.conf ]]; then
    info "nada em system/sddm, pulando"
  else
    # Um arquivo so, com prefixo numerico alto: o diretorio e lido em ordem e o
    # ultimo Current= vence. Na maquina de referencia havia DOIS arquivos
    # disputando (um do host dizendo `Corners`, outro dizendo outra coisa), e
    # qual ganhava dependia de ordem alfabetica - frageis os dois.
    local want; want="$(sed -n 's/^Current=//p' "$REPO/system/sddm/theme.conf" | tail -1)"
    if [[ -n $want && ! -d /usr/share/sddm/themes/$want ]]; then
      warn "o tema '$want' nao esta em /usr/share/sddm/themes"
      note "o arquivo sera escrito mesmo assim, mas instale o tema antes de deslogar"
    fi
    local others; others="$(grep -ls '^Current=' /etc/sddm.conf /etc/sddm.conf.d/*.conf 2>/dev/null | grep -v '50-omarchy-guest' || true)"
    if [[ -n $others ]]; then
      warn "outros arquivos tambem definem Current= neste diretorio:"
      local perdemos=0
      while read -r o; do
        [[ -n $o ]] || continue
        local ob; ob="$(basename "$o")"
        # O sddm le o diretorio em ordem e o ULTIMO `Current=` vence. Comparar
        # os nomes e a conta inteira - e dizer quem ganha vale mais do que
        # listar e deixar a pessoa adivinhar.
        if [[ $ob > "50-omarchy-guest.conf" ]]; then
          note "  $o  <- vence o nosso"
          perdemos=1
        else
          note "  $o"
        fi
      done <<< "$others"
      if ((perdemos)); then
        warn "com esses arquivos no lugar, o nosso NAO tem efeito."
        note "remova-os (ou o host os reescreve de novo no proximo update dele)"
        note "e so entao deslogue para ver a mudanca"
      fi
    fi
    sysbackup /etc/sddm.conf.d
    sysrun mkdir -p /etc/sddm.conf.d
    sysrun cp "$REPO/system/sddm/theme.conf" /etc/sddm.conf.d/50-omarchy-guest.conf
    ok "/etc/sddm.conf.d/50-omarchy-guest.conf"
  fi

  section "TTY (/etc/issue)"
  if [[ ! -f $REPO/system/issue ]]; then
    info "nada em system/issue, pulando"
  else
    sysbackup /etc/issue
    sysrun cp "$REPO/system/issue" /etc/issue
    ok "/etc/issue"
  fi

  if ((SYS_DRY)); then
    echo; info "nada foi escrito"
  else
    section "Depois"
    info "o splash e o /etc/issue so aparecem no proximo BOOT"
    info "a tela de login, no proximo logout"
    note "backups em $SYSTEM_BACKUP/$SYS_STAMP"
  fi
  echo
}

usage() {
  cat <<'EOF'
omarchy-guest - run the Omarchy shell as a guest, not as the owner

usage:
  omarchy-guest doctor              inspect this machine, change nothing
  omarchy-guest bootstrap [--dry-run]
                                    from a plain Arch + Hyprland to this flavor:
                                    packages, the Omarchy clone, and what is missing
  omarchy-guest install [--dry-run] copy plugins and menu overrides into place
  omarchy-guest system  [--dry-run] install the half that lives outside $HOME
                                    (plymouth splash, sddm theme, /etc/issue)
  omarchy-guest version

`doctor` never writes. `install` backs up every destination first and needs no
sudo. `system` is the only subcommand that writes outside $HOME; it asks for
sudo one action at a time and backs up everything it replaces.
EOF
}

case "${1:-doctor}" in
  doctor)  doctor ;;
  bootstrap) shift; bootstrap_all "${1:-}" ;;
  install) shift; install_all "${1:-}" ;;
  system)  shift; system_all "${1:-}" ;;
  version) echo "omarchy-guest $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac

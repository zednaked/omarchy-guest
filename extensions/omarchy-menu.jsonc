{
  // Extensoes do menu do Omarchy. Template comentado em
  // $OMARCHY_PATH/config/omarchy/extensions/omarchy-menu.jsonc
  //
  // Reusar um id existente sobrescreve a entrada; ids pontuados definem o pai.
  // `when` e condicao de shell: falhou, a linha some do menu.
  //
  // POR QUE AQUI E NAO NO MENU DELES: este arquivo nao e tocado pelo
  // `omarchy update` nem pelas migrations. Conferido em 03/09/2026 - nenhuma
  // migration menciona `extensions`, e o `omarchy-update` nao escreve em
  // ~/.config/omarchy. Editar
  // `$OMARCHY_PATH/default/omarchy/omarchy-menu.jsonc` funcionaria hoje e
  // seria desfeito no proximo update deles.
  //
  // Esta maquina roda o shell do Omarchy como CONVIDADO, sobre outro dono
  // (HyDE nas duas primeiras instalacoes). Varias acoes do menu deles
  // pressupoem ser donas da maquina, e algumas destroem config que aqui e de
  // outro dono. Este arquivo faz tres coisas: troca o atualizador, esconde o
  // que sobrescreve arquivo, e devolve ao host o que e do host. Confira cada
  // linha contra o SEU host - o comando por tras de cada uma e legivel com
  // `cat $(which <comando>)`.
  //
  // Regra de portabilidade: nenhuma acao aqui depende de comando do guest por
  // nome puro. O PATH do processo do shell varia entre hosts (environment.d,
  // autostart, wrapper); o que precisa de caminho usa candidatos explicitos,
  // como a linha do atualizador.

  // ==========================================================================
  // 1. Update: motor do HyDE no lugar do deles
  // ==========================================================================
  //
  // O menu oficial tem "update.omarchy" chamando `omarchy-update`: atualiza o
  // repositorio deles, roda migrations e no fim chama o gerenciador de pacotes.
  // Boa para o Omarchy, cega para o resto - nao diz quantos pacotes ha nem de
  // onde vem.
  //
  // A PRIMEIRA linha passa a ser o atualizador vendorizado em
  // vendor/hyde-updater (originalmente do HyDE, GPL-3),
  // com backend por gerenciador, contagem por origem, e inventario publicado em
  // $XDG_RUNTIME_DIR/omarchy-guest/update_info.json - o mesmo arquivo que
  // alimenta o widget `zed.updates` na barra.
  //
  // A troca reusa o id `update.omarchy` em vez de criar um id novo de proposito:
  // a ordem das linhas vem da ordem de definicao, entao id novo cairia no fim.
  "update.omarchy": {
    "icon": "󰏔",
    "label": "System",
    "description": "Todos os pacotes, por origem, com o inventario do HyDE",
    "action": "omarchy-launch-floating-terminal-with-presentation 'sh -c \"for c in \\\"$OMARCHY_GUEST_UPDATER\\\" \\\"$HOME/.local/share/omarchy-guest/updater/system.update.py\\\" \\\"$HOME/.local/lib/hyde/system.update.py\\\"; do [ -n \\\"$c\\\" ] && [ -f \\\"$c\\\" ] && exec python3 \\\"$c\\\" interactive; done; echo nenhum atualizador encontrado; read _\"'"
  },

  // O atualizador do Omarchy nao foi removido: e a unica forma de atualizar o
  // checkout deles e rodar migration. Virou linha propria, com rotulo honesto.
  "update.omarchy-repo": {
    "icon": "󰚰",
    "label": "Omarchy (repo e migrations)",
    "description": "Atualiza o checkout do Omarchy e roda as migrations dele",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-update"
  },


  // --- Channel: a linha mais destrutiva do menu -----------------------------
  //
  // `omarchy-channel-set` NAO troca so um canal de pacote. Nesta maquina ele:
  //
  //   1. `omarchy-refresh-pacman` sobrescreve /etc/pacman.conf E
  //      /etc/pacman.d/mirrorlist pelos do Omarchy, e roda
  //      `sudo pacman -Syyuu --noconfirm` - o `-uu` permite DOWNGRADE, entao o
  //      sistema inteiro pode ser rebaixado para a versao dos espelhos deles,
  //      sem confirmacao;
  //   2. instala os pacotes `omarchy` e `omarchy-settings` no sistema com
  //      `--noconfirm --ask 4`, que aceita substituicao de pacote calado;
  //   3. como aqui `OMARCHY_PATH` nao e /usr/share/omarchy, ele entra no ramo
  //      `leaving_dev` e roda `omarchy-dev-unlink`, que escreve /etc/omarchy.conf
  //      apontando para /usr/share/omarchy - orfanando o checkout em
  //      ~/.local/share/omarchy, que e o que esta maquina usa;
  //   4. termina com `omarchy-update -y`, migrations inclusas.
  //
  // Ou seja: uma linha de menu converte a maquina em Omarchy, sem pergunta.
  // E ela aparece marcada como "dev" aqui, porque o `omarchy-channel-current`
  // deduz dev de `OMARCHY_PATH != /usr/share/omarchy` - o que e verdade num
  // convidado sem que ninguem tenha escolhido nada.
  "update.channel.stable": { "when": "false" },
  "update.channel.rc": { "when": "false" },
  "update.channel.edge": { "when": "false" },
  "update.channel.dev": { "when": "false" },

  // No lugar do submenu, uma linha que so INFORMA. Canal e conceito de
  // instalacao por pacote; aqui o Omarchy e um clone git, e o equivalente
  // honesto e "em que branch esta o checkout e ele esta atrasado?".
  "update.channel": {
    "icon": "󰔫",
    "label": "Checkout do Omarchy",
    "description": "Mostra branch e commit do clone - nao troca canal, nao mexe em pacman",
    "action": "omarchy-launch-floating-terminal-with-presentation 'sh -c \"cd \\\"$OMARCHY_PATH\\\" && git status -sb && echo && git log --oneline -5 && echo && read -p \\\"enter para fechar\\\" _\"'"
  },

  // ==========================================================================
  // 2. O que sobrescreve arquivo do host, escondido
  // ==========================================================================
  //
  // Todas com `when: "false"`, que sempre falha e some com a linha. Escondidas
  // e nao so renomeadas porque o menu tem busca difusa: um "config" digitado
  // rapido mais Enter e o suficiente para acionar.

  // MAIS PERIGOSA. `omarchy-refresh-hyprland` sobrescreve, com os defaults
  // deles: hyprland.lua, monitors.lua, looknfeel.lua, autostart.lua,
  // bindings.lua e input.lua. Num guest o hyprland.lua e a camada de override
  // do host - e num guest deste projeto e tambem onde vive a supressao de
  // barra/notificacao e o autostart do shell. Acionar isso quebra a sessao no
  // proximo login, sem nenhum erro na hora.
  "update.config.hyprland": { "when": "false" },

  // `omarchy-refresh-shell` reseta o shell.json e roda `omarchy-bar defaults`:
  // apaga o layout da barra e a lista de plugins - os de terceiro mais os
  // deste repo.
  "update.config.shell": { "when": "false" },

  // `omarchy-refresh-plymouth` e `omarchy-plymouth-reset` (este ultimo tambem
  // chama `omarchy-refresh-sddm`) sobrescrevem o splash de boot e o tema do
  // SDDM. Numa maquina com tema proprio (a referencia tem identidade zednet
  // nos dois) isso destroi trabalho; numa maquina sem plymouth/SDDM (GDM) as
  // linhas so confundem. Escondidas nos dois casos.
  "update.config.plymouth": { "when": "false" },
  "style.unlock": { "when": "false" },

  // `omarchy-refresh-hyprsunset` sobrescreve ~/.config/hypr/hyprsunset.conf -
  // num host HyDE esse arquivo e dele, ajustado ou nao.
  "update.config.hyprsunset": { "when": "false" },

  // `omarchy-refresh-tmux` sobrescreve o tmux.conf com o default deles.
  // Inofensivo onde nao ha config de tmux para perder; destrutivo onde ha.
  // Escondido nos dois casos, porque com os outros quatro filhos fora o pai
  // `update.config` some junto (abaixo) e esta linha ficaria sozinha num
  // submenu chamado "Reset to default".
  "update.config.tmux": { "when": "false" },

  // Com os cinco filhos de Update > Config escondidos, o pai viraria um
  // submenu vazio apontando para o nada. Some junto.
  "update.config": { "when": "false" },

  // Reset de fabrica. Em raiz ext4 a condicao deles ja esconde; em btrfs nao.
  // Explicito aqui, o disco pode mudar um dia e a linha nao volta sozinha.
  "setup.reset": { "when": "false" },

  // ==========================================================================
  // 3. Sessao hibrida: lock, idle e daemons sao do HOST
  // ==========================================================================
  //
  // A regra destas linhas e diferente da secao 2: nada aqui sobrescreve
  // arquivo. O perigo e de ESTADO - a linha aciona o lado do Omarchy de um
  // recurso cujo dono nesta maquina e o host, e o resultado e silencioso:
  // um "Lock" que nao tranca, dois daemons de idle brigando, um processo
  // re-parentado para fora do unit que o vigia. Onde ha equivalente do host,
  // a linha e SUBSTITUIDA (mesma cara, funcao honesta); onde nao ha, some.
  //
  // Preferencia, nesta ordem: (a) a interface que qualquer host entende
  // (logind, inibidores do systemd), (b) o comando original deles envolvido por
  // um shim em shims/, (c) o nome de um unit do host, que e o unico que precisa
  // de adaptacao por maquina.

  // PIOR CASO DO MENU INTEIRO: falsa seguranca. `omarchy-system-lock` fala
  // com o plugin omarchy.lock, que aqui esta desabilitado (sem o PAM dele,
  // ASSUMPTIONS §6) - o IPC vira no-op e a linha "Lock" NAO TRANCA NADA,
  // sem erro nenhum.
  //
  // A troca e `loginctl lock-session`, nao um locker pelo nome: e o pedido de
  // lock do logind, que o daemon de idle do host ja escuta - hypridle roda o
  // `lock_cmd` do proprio hypridle.conf (no HyDE, `pidof hyprlock || hyprlock`,
  // com a guarda contra instancia dupla), swayidle e afins idem. Assim a linha
  // tranca com o locker que o host escolheu, sem este arquivo saber qual e. E
  // o mesmo caminho que o `hyde-shell lock-session` do HyDE usa.
  // Pre-requisito: o hypridle.conf do host precisa ter `lock_cmd` na secao
  // `general`; sem ele o pedido do logind cai no vazio, do mesmo jeito que a
  // linha original. Conferir com `grep lock_cmd ~/.config/hypr/hypridle.conf`.
  "system.lock": {
    "icon": "",
    "label": "Lock",
    "action": "loginctl lock-session"
  },

  // O screensaver do Omarchy e ttfx + o plugin de idle deles, nenhum dos dois
  // presente/ativo aqui. Linha morta; escondida em vez de fingir.
  "system.screensaver": { "when": "false" },
  "trigger.toggle.screensaver": { "when": "false" },

  // "Stay Awake" NAO e sobrescrito aqui de proposito. A linha original chama
  // `omarchy-toggle-idle`, e quem responde e o shim em shims/ (na frente do
  // bin/ deles pelo omarchy-guest-run): ele roda o original, que grava o
  // indicador do Omarchy, e segura um `systemd-inhibit --what=idle` enquanto
  // o indicador existir. O daemon de idle do host continua de pe (brilho,
  // DPMS), so o idle e inibido, e o estado do Omarchy e o real andam juntos.
  // Uma linha que parasse o unit de idle por fora deixaria o indicador
  // dizendo uma coisa e o daemon fazendo outra, e dependeria do nome do unit.

  // "update.process.hyprsunset" NAO e mais sobrescrito aqui, e o motivo vale
  // registrar porque o mesmo raciocinio vai reaparecer noutro host:
  //
  // Enquanto o hyprsunset era um unit do host, `omarchy-restart-hyprsunset`
  // matava e relancava o processo POR FORA do systemd - o daemon continuava,
  // mas orfao do unit que o vigiava, e o restart "honesto" era o do unit. Era
  // o unico nome de unit deste arquivo.
  //
  // Em 09/09/2026 o unit do host foi desligado: `omarchy.nightlight` sobe o
  // hyprsunset sozinho quando alguem pede temperatura. Sem unit vigiando, a
  // linha original deles voltou a ser a correta - matar e relancar e
  // exatamente o que se faz com um processo sem supervisor. Um override aqui
  // agora reiniciaria um unit parado, e o resultado seria dois hyprsunset.

  // Grava uma entrada EFI apontando para a UKI DO OMARCHY - takeover da
  // cadeia de boot numa maquina que boota pelo caminho do host.
  "setup.direct-boot": { "when": "false" },

  // "Style > Hyprland" abre looknfeel.lua. Isso esta certo onde o arquivo e
  // FIADO - o hyprland.lua do usuario o carrega (dofile/require), como na
  // maquina de referencia, onde o Omaland escreve nele. Existir nao basta:
  // num guest o looknfeel.lua e orfao ate ser fiado (THEMING.md), e abrir um
  // arquivo que nada le e o mesmo "mudei e continua igual" do painel. Onde nao
  // esta fiado, a camada honesta e o hyprland.lua do usuario, o mesmo arquivo
  // onde vive a fiacao do guest. A acao decide na hora, em vez de este arquivo
  // escolher por um host.
  "style.hyprland": {
    "icon": "",
    "label": "Hyprland",
    "action": "sh -c 'f=\"$HOME/.config/hypr/looknfeel.lua\"; { [ -f \"$f\" ] && grep -q looknfeel \"$HOME/.config/hypr/hyprland.lua\"; } || f=\"$HOME/.config/hypr/hyprland.lua\"; exec omarchy-launch-config-editor \"$f\"'"
  }
}

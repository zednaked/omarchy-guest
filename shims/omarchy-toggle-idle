#!/bin/bash
# Shim: o Stay Awake passa a segurar de verdade o idle do HOST.
#
# O `omarchy-toggle-idle` original so escreve/apaga
# `~/.local/state/omarchy/indicators/stay-awake`. Quem leria esse estado e o
# plugin `omarchy.idle`, que num guest esta DESLIGADO de proposito - idle e lock
# sao do host (hypridle + hyprlock, ou o que o host usar), porque a tela de
# bloqueio do Omarchy exige um PAM que so o instalador deles cria
# (ASSUMPTIONS §6). Sem este shim a linha "Stay Awake" do menu troca o estado e
# nao inibe nada.
#
# Por que inibidor e nao stop/start do unit de idle:
#   - `systemd-inhibit --what=idle` e a interface que QUALQUER daemon de idle
#     respeita (hypridle: `ignore_systemd_inhibit` e false por padrao; swayidle
#     e o do GNOME idem). Nao depende do nome do unit do host.
#   - o daemon continua vivo: brilho, DPMS e o resto seguem funcionando; so o
#     idle e segurado.
#   - o estado do Omarchy (o arquivo indicador) e o estado real andam JUNTOS,
#     porque este shim envolve o comando original em vez de contorna-lo. Uma
#     linha de menu que fizesse `systemctl --user stop <idle>` por fora deixaria
#     o indicador dizendo uma coisa e o daemon fazendo outra.
#
# Para valer, este diretorio tem que vir ANTES do bin/ deles no PATH do processo
# que chama - e o `omarchy-guest-run` que garante isso para o shell.
set -uo pipefail

real="${OMARCHY_PATH:-$HOME/.local/share/omarchy}/bin/omarchy-toggle-idle"
estado="$HOME/.local/state/omarchy/indicators/stay-awake"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/omarchy-guest-stay-awake.pid"

# `status` nao muda nada; repassa e sai.
if [[ ${1:-toggle} == "status" || ${1:-} == "--status" ]]; then
  exec "$real" "$@"
fi

saida=$("$real" "$@") || exit $?
printf '%s\n' "$saida"

inibidor_vivo() {
  [[ -f $pidfile ]] || return 1
  local pid; pid=$(<"$pidfile")
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

if [[ -f $estado ]]; then
  # Stay Awake ligado: segura o inibidor se ainda nao houver um.
  if ! inibidor_vivo; then
    setsid systemd-inhibit --what=idle \
      --who="Omarchy Stay Awake" --why="Stay Awake ligado no menu" \
      sleep infinity >/dev/null 2>&1 &
    echo $! >"$pidfile"
  fi
else
  # Stay Awake desligado: solta.
  if inibidor_vivo; then
    kill "$(<"$pidfile")" 2>/dev/null
  fi
  rm -f "$pidfile"
fi
